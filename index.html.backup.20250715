    <!-- FAQ Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is phenol-free thermal receipt paper?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Phenol-free thermal paper is formulated without phenol-based developers like BPA or BPS. Clarion by Domtar is the first phenol-free POS paper certified recyclable in North America per WMU standard. Performs identically to standard thermal paper with 10-year image life and backside printable."
          }
        },
        {
          "@type": "Question",
          "name": "What are thermal receipt paper rolls?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Thermal receipt paper is heat-sensitive paper used in POS printers. When heat is applied, it creates sharp black text without ink. We stock BPA-free thermal paper that's safe for staff and customers."
          }
        },
        {
          "@type": "Question",
          "name": "What size receipt paper do I need for my POS printer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most receipt printers use 2 1/4 inch (58mm) or 3 1/8 inch (80mm) width paper. Check your current roll, printer model number, or call us at (888) 881-6834. We carry all standard sizes for Square, Clover, Toast, and other POS systems."
          }
        },
        {
          "@type": "Question",
          "name": "How long does thermal receipt paper last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "When stored properly away from heat, light, and humidity, thermal paper lasts 3-5 years. Printed receipts remain readable for 1-2 years. Our phenol-free thermal paper has enhanced stability for better longevity."
          }
        },
        {
          "@type": "Question",
          "name": "Best receipt paper for Clover POS systems",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clover stations use 3 1/8 inch x 230 foot thermal rolls. We stock premium BPA-free thermal paper compatible with Clover Mini, Station, and Flex models. Tested for smooth feeding and reliable printing."
          }
        },
        {
          "@type": "Question",
          "name": "Receipt paper for restaurants",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Restaurants need high-volume thermal paper that withstands kitchen heat and humidity. We recommend 3 1/8 inch x 230 foot phenol-free thermal rolls. We also stock 2-ply carbonless paper for duplicate copies."
          }
        },
        {
          "@type": "Question",
          "name": "Thermal paper vs regular paper",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ink ribbon printers need bond paper. Thermal printers (no ribbon) need thermal paper. Most modern POS receipt printers are thermal. Check for a ribbon compartment—if none exists, it's thermal."
          }
        },
        {
          "@type": "Question",
          "name": "Where to buy receipt paper rolls near me",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We ship nationwide with same-day processing. Local California delivery available in Bay Area, Los Angeles, and San Diego. Most California customers receive orders in 1-2 business days. Call (888) 881-6834 for emergency delivery."
          }
        },
        {
          "@type": "Question",
          "name": "Bulk receipt paper pricing",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tiered discounts: 5-9 cases (5% off), 10-19 cases (10% off), 20+ cases (15% off + free shipping). Monthly subscriptions save an additional 5%. Contact us for custom pricing on large orders."
          }
        },
        {
          "@type": "Question",
          "name": "Fast shipping thermal paper rolls",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "California: 1-2 business days. West Coast: 2-3 days. Central and East Coast: 3-5 days. Ships from California via UPS and FedEx. Expedited shipping available at checkout."
          }
        },
        {
          "@type": "Question",
          "name": "What POS supplies does Performance Supply Depot offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer thermal paper rolls, printer ribbons, POS hardware including Samsung systems, scales, and professional repair services for all major POS brands."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer bulk discounts on POS supplies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes! We offer competitive bulk pricing on thermal paper, printer ribbons, and POS hardware. Contact us for volume pricing on orders over $500."
          }
        },
        {
          "@type": "Question",
          "name": "What areas do you serve?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We serve businesses throughout California and ship nationwide. Local delivery available in the Bay Area."
          }
        },
        {
          "@type": "Question",
          "name": "Do you provide POS repair services?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we provide professional repair services for Samsung POS systems, receipt printers, and other POS hardware. On-site service available."
          }
        },
        {
          "@type": "Question",
          "name": "POS printer repair near me",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We repair Epson, Star, and all major POS printer brands throughout California. In-shop diagnostics $195/hour, on-site service $180/hour. Bay Area, LA, and San Diego coverage."
          }
        },
        {
          "@type": "Question",
          "name": "How often should POS printers be serviced?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "High-volume businesses should schedule maintenance every 3-6 months. Signs you need service: faded prints, paper jams, grinding noises, or connectivity issues. Regular cleaning extends printer life."
          }
        },
        {
          "@type": "Question",
          "name": "POS installation services",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Complete POS installations for restaurants, retail, and convenience stores throughout California. $180/hour includes hardware setup, software configuration, network integration, and staff training."
          }
        },
        {
          "@type": "Question",
          "name": "Best POS hardware for small businesses",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SAM4S ER-260 series cash registers starting at $495—reliable, programmable, no monthly fees. For growing businesses: Samsung POS terminals and integrated scales. Free consultation available."
          }
        },
        {
          "@type": "Question",
          "name": "Epson printer ribbons vs Star—which ones do I need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Epson printers use ERC 30/34/38 series ribbons. Star printers (SP700) use Star-specific ribbons. Check your printer model number. We stock black and black/red options."
          }
        },
        {
          "@type": "Question",
          "name": "What is carbonless paper used for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Carbonless paper (NCR paper) creates instant duplicate or triplicate copies without carbon sheets. Essential for businesses needing customer and merchant copies. We stock 2-ply and 3-ply."
          }
        },
        {
          "@type": "Question",
          "name": "Credit card machine paper size",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most credit card terminals use 2 1/4 inch thermal paper. Verifone, Ingenico, and Square terminals all use this standard size. We stock 50-foot rolls sized for payment terminals."
          }
        },
        {
          "@type": "Question",
          "name": "POS supplies for convenience stores",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Convenience stores need high-volume thermal paper, scale labels, and durable hardware running 18+ hours daily. We supply integrated POS scales, label printers, and bulk thermal paper with volume pricing."
          }
        }
      ]
    }
    </script>
    
