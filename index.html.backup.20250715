    <section id="services">
        <div class="container">
            <h2 class="section-title">Professional Services</h2>
            <p class="section-subtitle">Expert repair and installation services for your business</p>
            
            <div class="services-grid">
                <div class="service-card">
                    <div class="service-icon">🔌</div>
                    <h3>Custom Cabling</h3>
                    <p>Professional network and POS cabling installation. Structured cabling for retail and restaurant environments. Clean, organized, and tested.</p>
                    <div class="service-price">Starting at <strong>$180/hour</strong></div>
                </div>

                <div class="service-card">
                    <div class="service-icon">🔧</div>
                    <h3>Printer Repair</h3>
                    <p>Expert repair services for Epson, Star, and all major POS printer brands. In-shop diagnostics and on-site service available.</p>
                    <div class="service-price">In-shop: <strong>$195/hour</strong></div>
                </div>

                <div class="service-card">
